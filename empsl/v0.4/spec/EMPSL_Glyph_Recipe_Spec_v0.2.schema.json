{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/spec/empsl-glyph-recipe-v0.2.schema.json",
  "title": "EMPSL Glyph Recipe v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "frame",
    "seed",
    "phonology",
    "tone",
    "phase",
    "operator",
    "recipe_sha256"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)*:[a-z][a-z0-9_-]*:[0-9a-z_-]+$"
    },
    "version": {
      "const": "0.2"
    },
    "frame": {
      "enum": [
        "SEM-ENTITY",
        "SEM-PROCESS",
        "SEM-RELATION",
        "SEM-PROPERTY",
        "SEM-QUANTITY",
        "SEM-TIME",
        "SEM-SPACE",
        "SEM-MODALITY",
        "SEM-CAUSALITY",
        "SEM-EVIDENCE",
        "SEM-AGENT",
        "SEM-INFORMATION",
        "SEM-PERMISSION",
        "SEM-NEGATION",
        "SEM-AGGREGATION",
        "SEM-META"
      ]
    },
    "seed": {
      "enum": [
        "ENO-01",
        "ENO-02",
        "ENO-03",
        "ENO-04",
        "ENO-05",
        "ENO-06",
        "ENO-07",
        "ENO-08",
        "ENO-09",
        "ENO-10",
        "ENO-11",
        "ENO-12",
        "ENO-13",
        "ENO-14",
        "ENO-15",
        "ENO-16",
        "ENO-17",
        "ENO-18",
        "ENO-19",
        "ENO-20",
        "ENO-21",
        "STR-01",
        "STR-02",
        "STR-03",
        "STR-04",
        "STR-05",
        "STR-06",
        "STR-07",
        "STR-08",
        "STR-09",
        "STR-10",
        "STR-11"
      ]
    },
    "phonology": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ONSET-B",
          "ONSET-P",
          "ONSET-M",
          "ONSET-F",
          "ONSET-D",
          "ONSET-T",
          "ONSET-N",
          "ONSET-L",
          "ONSET-G",
          "ONSET-K",
          "ONSET-H",
          "ONSET-J",
          "ONSET-Q",
          "ONSET-X",
          "ONSET-ZH",
          "ONSET-CH",
          "ONSET-SH",
          "ONSET-R",
          "ONSET-Z",
          "ONSET-C",
          "ONSET-S",
          "HU-KAIKOU",
          "HU-QICHI",
          "HU-HEKOU",
          "HU-CUOKOU",
          "RIME-A",
          "RIME-O",
          "RIME-E",
          "RIME-AI",
          "RIME-EI",
          "RIME-AO",
          "RIME-OU",
          "RIME-AN",
          "RIME-EN",
          "RIME-ANG",
          "RIME-ENG",
          "RIME-ER",
          "ST-ZERO",
          "ST-NASAL",
          "ST-RHOTIC",
          "ST-LIGHT",
          "ST-LONG",
          "ST-BOUNDARY"
        ]
      }
    },
    "tone": {
      "enum": [
        "T1",
        "T2",
        "T3",
        "T4",
        "T0"
      ]
    },
    "phase": {
      "enum": [
        "PH16-00",
        "PH16-01",
        "PH16-02",
        "PH16-03",
        "PH16-04",
        "PH16-05",
        "PH16-06",
        "PH16-07",
        "PH16-08",
        "PH16-09",
        "PH16-10",
        "PH16-11",
        "PH16-12",
        "PH16-13",
        "PH16-14",
        "PH16-15"
      ]
    },
    "operator": {
      "enum": [
        "OP-NULL",
        "OP-UNARY",
        "OP-BINARY",
        "OP-TERNARY",
        "OP-VARIADIC",
        "OP-BIND",
        "OP-QUOTE",
        "OP-META",
        "OP-TEMP",
        "OP-MODAL",
        "OP-NEG",
        "OP-CAUSE",
        "OP-AGG",
        "OP-MAP",
        "OP-REDUCE",
        "OP-GUARD"
      ]
    },
    "reading": {
      "type": "string"
    },
    "gloss": {
      "type": "string"
    },
    "concept_id": {
      "type": "string"
    },
    "recipe_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}