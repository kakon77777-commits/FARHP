{
  "name": "axioglyph",
  "compatibility_date": "2026-08-22",
  "assets": {
    "directory": "./site/dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "axioglyph.evemisslab.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
