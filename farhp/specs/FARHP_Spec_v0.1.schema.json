{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logic.evemisslab.com/spec/farhp/0.1/schema.json",
  "title": "FARHP-Spec v0.1 Reference Object",
  "type": "object",
  "required": [
    "farhp_version",
    "domain",
    "anchor",
    "analysis",
    "phase",
    "polarity_policy"
  ],
  "properties": {
    "farhp_version": {
      "const": "0.1"
    },
    "domain": {
      "enum": ["Y", "G"]
    },
    "anchor": {
      "type": "object",
      "required": ["type", "confidence"],
      "properties": {
        "type": {
          "enum": ["fundamental", "bezout", "generalized"]
        },
        "harmonic_index": {
          "type": "integer",
          "minimum": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": true
    },
    "analysis": {
      "type": "object",
      "required": [
        "method",
        "method_version",
        "sample_rate_hz",
        "frame_time_sec",
        "f0_hz",
        "f0_confidence",
        "applicability_grade"
      ],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "method_version": {"type": "string", "minLength": 1},
        "sample_rate_hz": {"type": "integer", "minimum": 1},
        "frame_time_sec": {"type": "number", "minimum": 0},
        "frame_length_sec": {"type": "number", "exclusiveMinimum": 0},
        "f0_hz": {"type": "number", "exclusiveMinimum": 0},
        "f0_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "applicability_grade": {"type": "integer", "minimum": 0, "maximum": 4}
      },
      "additionalProperties": true
    },
    "phase": {
      "type": "object",
      "required": ["representation", "harmonic_indices", "mask", "confidence"],
      "properties": {
        "representation": {
          "enum": [
            "angle_rad",
            "unit_circle_xy",
            "complex_pair",
            "scalar_quantized",
            "joint_torus_codebook",
            "product_codebook",
            "joint_plus_residual",
            "not_applicable"
          ]
        },
        "harmonic_indices": {
          "type": "array",
          "items": {"type": "integer", "minimum": 2},
          "uniqueItems": true
        },
        "values": {
          "type": "array"
        },
        "mask": {
          "type": "array",
          "items": {"type": "integer", "enum": [0, 1]}
        },
        "confidence": {
          "type": "array",
          "items": {"type": "number", "minimum": 0, "maximum": 1}
        }
      },
      "additionalProperties": true
    },
    "codebook": {
      "type": "object",
      "required": ["id", "version", "kind"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "kind": {
          "enum": ["scalar", "joint_torus", "product", "joint_plus_residual"]
        },
        "token_type": {
          "enum": ["ABS", "DELTA", "RESIDUAL", "MASK", "CONF", "DOMAIN", "SYNC", "NA", "OOD", "END"]
        },
        "token_index": {"type": "integer", "minimum": 0},
        "ood_distance": {"type": "number", "minimum": 0}
      },
      "additionalProperties": true
    },
    "polarity_policy": {
      "enum": ["preserve", "normalize", "separate_bit", "equivariant", "unknown"]
    },
    "inverse_filter": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"domain": {"const": "G"}},
        "required": ["domain"]
      },
      "then": {
        "required": ["inverse_filter"]
      }
    },
    {
      "if": {
        "properties": {
          "phase": {
            "properties": {
              "representation": {
                "enum": ["scalar_quantized", "joint_torus_codebook", "product_codebook", "joint_plus_residual"]
              }
            },
            "required": ["representation"]
          }
        }
      },
      "then": {
        "required": ["codebook"]
      }
    }
  ],
  "additionalProperties": true
}
