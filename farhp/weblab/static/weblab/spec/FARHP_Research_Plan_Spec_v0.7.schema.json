{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/spec/FARHP_Research_Plan_Spec_v0.7.schema.json",
  "title": "FARHP WebLab Research Plan v0.7",
  "type": "object",
  "required": [
    "farhp_weblab_plan_version",
    "study_id",
    "task",
    "planned_sample_size",
    "primary_endpoint",
    "design",
    "exclusion_policy",
    "status",
    "created_at",
    "locked_at",
    "plan_fingerprint"
  ],
  "properties": {
    "farhp_weblab_plan_version": {
      "const": "0.7"
    },
    "study_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "task": {
      "const": "multi_stimulus_ABX_identity_match"
    },
    "planned_sample_size": {
      "type": "integer",
      "minimum": 1
    },
    "primary_endpoint": {
      "const": "abx_accuracy_vs_0_5"
    },
    "preregistration_note": {
      "type": "string",
      "maxLength": 1200
    },
    "design": {
      "type": "object",
      "required": [
        "selected_stimuli",
        "altered_condition",
        "intervention_strength",
        "repeats_per_stimulus",
        "practice_trials",
        "break_every_main_trials",
        "seed",
        "ordering",
        "blinding"
      ],
      "properties": {
        "selected_stimuli": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "altered_condition": {
          "enum": [
            "zero",
            "alternating",
            "random",
            "curved"
          ]
        },
        "intervention_strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "repeats_per_stimulus": {
          "type": "integer",
          "minimum": 1
        },
        "practice_trials": {
          "type": "integer",
          "minimum": 0
        },
        "break_every_main_trials": {
          "type": "integer",
          "minimum": 0
        },
        "seed": {
          "type": "integer",
          "minimum": 1
        },
        "ordering": {
          "type": "string"
        },
        "blinding": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "exclusion_policy": {
      "type": "object",
      "required": [
        "min_rt_ms",
        "max_rt_ms",
        "min_completion_ratio",
        "min_valid_trial_ratio",
        "min_plays_each_label",
        "accuracy_based_exclusion"
      ],
      "properties": {
        "min_rt_ms": {
          "type": "number",
          "minimum": 0
        },
        "max_rt_ms": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "min_completion_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_valid_trial_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_plays_each_label": {
          "type": "integer",
          "minimum": 0
        },
        "accuracy_based_exclusion": {
          "const": false
        }
      },
      "additionalProperties": true
    },
    "status": {
      "enum": [
        "draft",
        "locked"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "locked_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "plan_fingerprint": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "algorithm",
            "value"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": true
}