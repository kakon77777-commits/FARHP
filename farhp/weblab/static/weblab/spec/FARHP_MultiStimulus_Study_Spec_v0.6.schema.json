{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evemisslab.com/spec/FARHP_MultiStimulus_Study_Spec_v0.6.schema.json",
  "title": "FARHP WebLab Multi-Stimulus Study v0.6",
  "type": "object",
  "required": [
    "farhp_weblab_study_version", "session_id", "study_id", "participant_id",
    "created_at", "task", "setup", "invariant_certificates", "stimuli", "trials", "summary"
  ],
  "properties": {
    "farhp_weblab_study_version": {"const": "0.6"},
    "session_id": {"type": "string", "minLength": 1},
    "study_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "participant_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "created_at": {"type": "string"},
    "completed_at": {"type": ["string", "null"]},
    "task": {"const": "multi_stimulus_ABX_identity_match"},
    "setup": {
      "type": "object",
      "required": [
        "seed", "repeats_per_stimulus", "practice_trials", "break_every_main_trials",
        "selected_stimuli", "participant_latin_row", "ordering_method", "baseline_condition",
        "altered_condition", "intervention_strength", "randomization", "blinding"
      ],
      "properties": {
        "seed": {"type": "integer", "minimum": 1},
        "repeats_per_stimulus": {"type": "integer", "minimum": 1, "maximum": 20},
        "practice_trials": {"type": "integer", "minimum": 0, "maximum": 20},
        "break_every_main_trials": {"type": "integer", "minimum": 0},
        "selected_stimuli": {"type": "array", "minItems": 2, "items": {"type": "string"}, "uniqueItems": true},
        "participant_latin_row": {"type": "integer", "minimum": 0},
        "ordering_method": {"type": "string"},
        "baseline_condition": {"type": "string"},
        "altered_condition": {"enum": ["zero", "alternating", "random", "curved"]},
        "altered_condition_label": {"type": "string"},
        "intervention_strength": {"type": "number", "minimum": 0, "maximum": 1},
        "randomization": {"type": "string"},
        "blinding": {"type": "string"}
      },
      "additionalProperties": true
    },
    "invariant_certificates": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/invariantCertificate"}
    },
    "stimuli": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["stimulus_key", "label", "bopomofo", "duration_seconds", "source_utterance", "invariant_certificate"],
        "properties": {
          "stimulus_key": {"type": "string"},
          "label": {"type": "string"},
          "bopomofo": {"type": "string"},
          "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
          "source_utterance": {"type": "object"},
          "invariant_certificate": {"$ref": "#/$defs/invariantCertificate"}
        },
        "additionalProperties": true
      }
    },
    "trials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sequence_index", "trial", "is_practice", "stimulus_key", "a_condition",
          "b_condition", "x_condition", "correct_answer", "play_counts", "response"
        ],
        "properties": {
          "sequence_index": {"type": "integer", "minimum": 1},
          "trial": {"type": "integer", "minimum": 1},
          "is_practice": {"type": "boolean"},
          "practice_ordinal": {"type": ["integer", "null"], "minimum": 1},
          "main_ordinal": {"type": ["integer", "null"], "minimum": 1},
          "stimulus_key": {"type": "string"},
          "a_condition": {"enum": ["baseline", "altered"]},
          "b_condition": {"enum": ["baseline", "altered"]},
          "x_condition": {"enum": ["baseline", "altered"]},
          "correct_answer": {"enum": ["A", "B"]},
          "play_counts": {
            "type": "object",
            "required": ["A", "B", "X"],
            "properties": {
              "A": {"type": "integer", "minimum": 0},
              "B": {"type": "integer", "minimum": 0},
              "X": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          },
          "response": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "required": ["answer", "correct", "rt_ms", "submitted_at"],
                "properties": {
                  "answer": {"enum": ["A", "B"]},
                  "correct": {"type": "boolean"},
                  "rt_ms": {"type": "number", "minimum": 0},
                  "submitted_at": {"type": "string"}
                },
                "additionalProperties": true
              }
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "practice_answered", "answered_main_trials", "correct_main_trials", "main_accuracy",
        "median_main_response_time_ms", "total_replays", "breaks_taken"
      ],
      "properties": {
        "practice_answered": {"type": "integer", "minimum": 0},
        "answered_main_trials": {"type": "integer", "minimum": 0},
        "correct_main_trials": {"type": "integer", "minimum": 0},
        "main_accuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "median_main_response_time_ms": {"type": ["number", "null"], "minimum": 0},
        "total_replays": {"type": "integer", "minimum": 0},
        "breaks_taken": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    },
    "privacy_note": {"type": "string"},
    "warning": {"type": "string"}
  },
  "$defs": {
    "invariantCertificate": {
      "type": "object",
      "required": [
        "stimulus_key", "same_sample_count", "same_duration", "max_f0_track_difference_hz",
        "same_lexical_bopomofo", "same_surface_bopomofo", "waveform_rms_difference", "pass"
      ],
      "properties": {
        "stimulus_key": {"type": "string"},
        "same_sample_count": {"type": "boolean"},
        "same_duration": {"type": "boolean"},
        "max_f0_track_difference_hz": {"type": "number", "minimum": 0},
        "same_lexical_bopomofo": {"type": "boolean"},
        "same_surface_bopomofo": {"type": "boolean"},
        "waveform_rms_difference": {"type": "number", "minimum": 0},
        "pass": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
