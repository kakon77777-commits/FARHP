FARHP_ENV=production
FARHP_DATABASE_URL=postgresql+psycopg://farhp:CHANGE_ME@db:5432/farhp
FARHP_SECRET_KEY=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
FARHP_DEIDENTIFICATION_SALT=GENERATE_A_SECOND_INDEPENDENT_RANDOM_SECRET
FARHP_DEMO_MODE=0
FARHP_LOCAL_AUTH_ENABLED=1
FARHP_AUTO_MIGRATE=1
FARHP_ALLOWED_HOSTS=farhp.example.org,localhost,127.0.0.1
FARHP_FORCE_HTTPS=0
FARHP_HSTS_SECONDS=31536000
FARHP_WORKERS=1
FARHP_FORWARDED_ALLOW_IPS=127.0.0.1

# Optional OIDC
FARHP_OIDC_ENABLED=0
FARHP_OIDC_ISSUER=https://id.example.org/realms/research
FARHP_OIDC_CLIENT_ID=farhp
FARHP_OIDC_CLIENT_SECRET=CHANGE_ME
FARHP_OIDC_REDIRECT_URI=https://farhp.example.org/api/auth/oidc/callback
FARHP_OIDC_SCOPE=openid profile email
FARHP_OIDC_ROLE_CLAIM=groups
FARHP_OIDC_DEFAULT_ROLE=analyst
FARHP_OIDC_ROLE_MAP={"farhp-pi":"principal_investigator","farhp-collector":"data_collector","farhp-analyst":"analyst"}
